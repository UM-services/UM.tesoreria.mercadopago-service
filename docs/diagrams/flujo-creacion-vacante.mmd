sequenceDiagram
    title Flujo de Creación de Preferencia de Pago (Vacantes)

    actor Usuario
    participant Frontend as "Interfaz de Usuario"
    participant Ctrl as "PreferenceVacanteController"
    participant Svc as "PreferenciaVacanteService"
    participant Caso as "CrearPreferenciaVacanteUseCase"
    participant Builder as "PreferenciaRequestBuilder"
    participant MPSvc as "MercadoPagoService"
    participant MP_API as "API de Mercado Pago"
    participant CtxSvc as "ContextoService"
    participant Core as "tesoreria-core-service"

    Usuario->>Frontend: 1. Solicita reservar una vacante
    Frontend->>Ctrl: 2. POST /api/tesoreria/mercadopago/vacante/preference/create
    Ctrl->>Svc: 3. crear(contexto, reserva)
    Svc->>Caso: 4. crear(contexto, reserva)

    alt initPoint existente
        Caso-->>Svc: 5. Retorna el contexto existente
    else Preferencia nueva
        Caso->>Builder: 5. construirParaReserva(contexto, reserva)
        Builder-->>Caso: 6. SolicitudPreferencia sin restricciones de medios de pago
        Caso->>MPSvc: 7. crear(solicitud)
        MPSvc->>MP_API: 8. POST /checkout/preferences
        MP_API-->>MPSvc: 9. init_point, preferenceId
        MPSvc-->>Caso: 10. PreferenciaMercadoPago
        Caso->>CtxSvc: 11. actualizar(contexto)
        CtxSvc->>Core: 12. PUT /updateContext/{id}
    end

    Ctrl-->>Frontend: 13. MercadoPagoContextDto
    Frontend->>Usuario: 14. Redirige a la URL de pago
